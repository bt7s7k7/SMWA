{
    "compilerOptions": {
        "incremental": true,
        "target": "es6",
        "sourceMap": true,
        "strict": true,
        "lib": [
            "ESNext",
        ],
        "module": "CommonJS",
        "outDir": "build",
        "preserveSymlinks": true,
        "useDefineForClassFields": false,
        "typeRoots": [
            "./node_modules/@types"
        ],
        "rootDir": "src",
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": [
        "src",
        "test"
    ]
}
